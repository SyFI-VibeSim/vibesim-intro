{
  "extends": "stylelint-config-standard",
  "rules": {
    "custom-property-empty-line-before": null,
    "declaration-empty-line-before": null,
    "no-descending-specificity": null,
    "media-feature-range-notation": null,
    "alpha-value-notation": null,
    "color-function-notation": null,
    "selector-class-pattern": [
      "^[a-z][a-z0-9]*(-[a-z0-9]+)*(--[a-z0-9]+(-[a-z0-9]+)*)?$",
      {
        "message": "Global class names are kebab-case, with -- for a modifier"
      }
    ],
    "value-keyword-case": null
  },
  "overrides": [
    {
      "files": [
        "**/*.module.css"
      ],
      "rules": {
        "selector-class-pattern": [
          "^([a-z][a-zA-Z0-9]*|[a-z][a-z0-9]*(-[a-z0-9]+)+)$",
          {
            "message": "Module classes are camelCase; a kebab-case name here must be a global class reached into with :global()"
          }
        ],
        "keyframes-name-pattern": [
          "^[a-z][a-zA-Z0-9]*$",
          {
            "message": "CSS Module keyframe names are scoped like classes, so camelCase"
          }
        ],
        "selector-pseudo-class-no-unknown": [
          true,
          {
            "ignorePseudoClasses": [
              "global"
            ]
          }
        ],
        "property-no-unknown": [
          true,
          {
            "ignoreProperties": [
              "composes"
            ]
          }
        ]
      }
    }
  ]
}
